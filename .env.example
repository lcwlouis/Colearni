# CoLearni backend environment variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# PostgreSQL connection string
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://colearni:colearni@localhost:5432/colearni

# Local private source storage root for Phase 10 upload objects.
# This directory is not committed. Uploaded bytes are private workspace data and
# are not included in public Trail Pack export.
SOURCE_STORAGE_ROOT=.colearni/source-storage

# ── LLM provider ──────────────────────────────────────────────────────────────
#
# LLM_PROVIDER selects the provider. Supported values:
#   openai       → OpenAI API (default, uses Responses API)
#   openrouter   → OpenRouter via OpenAI-compatible endpoint
#   anthropic    → Anthropic Claude (requires: pip install anthropic)
#   gemini       → Google Gemini via OpenAI-compatible endpoint
#   deepseek     → DeepSeek via OpenAI-compatible endpoint
#   ollama       → Local Ollama models via OpenAI-compatible endpoint
#   llamacpp     → Local LLaMA.cpp models via OpenAI-compatible endpoint
#
# LLM_API_BASE overrides the base URL for any provider (useful for local
# models, self-hosted endpoints, or corporate proxies).
#
# Provider quick-start examples:
#
#   # OpenAI (default)
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
#   # OpenRouter (single key for OpenAI, Anthropic, Gemini, Mistral, etc.)
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openai/gpt-4o-mini           # or anthropic/claude-3-haiku, google/gemini-flash-1.5
#   LLM_API_KEY=sk-or-...
#
#   # Anthropic (native SDK — requires: pip install -e ".[providers]")
#   # Without the extra, the server raises ImportError on the first LLM call.
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-3-5-haiku-20241022
#   LLM_API_KEY=sk-ant-...
#
#   # Google Gemini (OpenAI-compatible endpoint, no extra SDK needed)
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-1.5-flash
#   LLM_API_KEY=AIza...
#
#   # DeepSeek (OpenAI-compatible endpoint)
#   LLM_PROVIDER=deepseek
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-...
#
#   # Local Ollama (any provider, override base URL)
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3
#   LLM_API_KEY=ollama
#   LLM_API_BASE=http://localhost:11434/v1
#
#   # Local LLaMA.cpp (any provider, override base URL)
#   LLM_PROVIDER=llamacpp
#   LLM_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:MXFP4_MOE
#   LLM_API_KEY=llamacpp
#   LLM_API_BASE=http://localhost:8080

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
# LLM_API_BASE=

# ── Extended thinking / reasoning ─────────────────────────────────────────────
#
# LLM_THINKING_ENABLED  — master toggle (default: false).
#   When false nothing changes; all calls behave as before.
#   When true the client injects the thinking/reasoning param for the provider.
#   If the selected model does not support it the client logs a warning and
#   retries automatically without thinking — no crash.
#
# LLM_THINKING_BUDGET   — Anthropic: budget_tokens for extended thinking (min 1024).
#   Ignored for OpenAI-compatible providers.
#
# LLM_THINKING_LEVEL    — OpenAI o-series: reasoning_effort (low|medium|high).
#   Ignored for Anthropic.
#
# LLM_TUTOR_MAX_TOKENS  — requested tutor answer budget per LLM call.
#   Tune this independently from provider reasoning settings. Provider adapters
#   may still request extra headroom when reasoning is on so the visible answer
#   does not get crowded out.
#
# Provider quick-start examples:
#
#   # Anthropic extended thinking (claude-3-7-sonnet or newer)
#   LLM_THINKING_ENABLED=true
#   LLM_THINKING_BUDGET=8000
#
#   # OpenAI o-series (o1, o3, o4-mini, etc.)
#   LLM_THINKING_ENABLED=true
#   LLM_THINKING_LEVEL=medium
#
# LLM_THINKING_ENABLED=false
# LLM_THINKING_BUDGET=8000
# LLM_THINKING_LEVEL=medium
# LLM_TUTOR_MAX_TOKENS=4096
#
# Tokens per node for graph generation budget. Budget = clamp(max_nodes * this, 4096, 16000).
# Default 300. Increase if the LLM truncates large graphs (e.g. 500 or 600).
# LLM_GENERATION_TOKENS_PER_NODE=600

# ── Tutor context window ──────────────────────────────────────────────────────
#
# TUTOR_RECENT_VISIBLE_TURNS_LIMIT  — how many recent turns go verbatim into the
#   LLM prompt. Older turns are replaced by the rolling summary. Default: 10.
#
# TUTOR_HISTORY_CHAR_BUDGET  — total character count across all visible turns
#   that must be exceeded before summarisation is triggered. At ~4 chars/token
#   the default of 60 000 ≈ 15 k tokens. Short conversations never pay the cost.
#   A rough rule: set to 25-30% of your model's context window in characters
#   (e.g. 128 k-token model → ~128 000 chars).
#
# TUTOR_SUMMARY_BATCH_SIZE  — minimum number of new un-covered turns that must
#   accumulate before a fresh summary LLM call is issued. Prevents one-turn-at-a-
#   time re-summarisation. Default: 5.

# TUTOR_RECENT_VISIBLE_TURNS_LIMIT=10
# TUTOR_HISTORY_CHAR_BUDGET=60000
# TUTOR_SUMMARY_BATCH_SIZE=5

# ── Embedding provider ────────────────────────────────────────────────────────
#
# EMBEDDING_PROVIDER selects the embedding backend. Default is "disabled" which
# skips all embedding calls and falls back to ILIKE text search. Zero runtime
# cost for unconfigured deployments.
#
# Supported values:
#   disabled          → no embeddings; ILIKE fallback for source search (default)
#   openai            → OpenAI embeddings API
#   gemini            → Google Gemini via OpenAI-compatible endpoint
#   ollama            → Local Ollama models via OpenAI-compatible endpoint
#   openai_compatible → any OpenAI-compatible endpoint (set EMBEDDING_API_BASE)
#
# All providers use the OpenAI SDK with base_url overrides — no extra SDKs.
#
# Provider quick-start examples:
#
#   # OpenAI
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_API_KEY=sk-...
#
#   # Local Ollama
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_API_BASE=http://localhost:11434/v1
#
#   # OpenAI-compatible (e.g. LM Studio, vLLM)
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_MODEL=your-embedding-model
#   EMBEDDING_API_KEY=your-key
#   EMBEDDING_API_BASE=http://localhost:1234/v1

EMBEDDING_PROVIDER=disabled
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=
# EMBEDDING_DIM=1536

# ── Reranker ──────────────────────────────────────────────────────────────────
#
# RERANKER_PROVIDER selects the reranker used after chunk retrieval.
# Default is "none" (no reranking; results returned as-is).
#
# Supported values:
#   none      → no reranking (default)
#   cohere    → Cohere Rerank API (requires RERANKER_API_KEY)
#   flashrank → local FlashRank model (no API key required)

RERANKER_PROVIDER=none
# RERANKER_API_KEY=

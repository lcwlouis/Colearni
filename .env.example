# CoLearni backend environment variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# PostgreSQL connection string
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://colearni:colearni@localhost:5432/colearni

# ── LLM provider ──────────────────────────────────────────────────────────────
#
# LLM_PROVIDER selects the provider. Supported values:
#   openai       → OpenAI API (default)
#   openrouter   → OpenRouter (access 100+ models via one key)
#   anthropic    → Anthropic Claude (requires: pip install anthropic)
#   gemini       → Google Gemini via OpenAI-compatible endpoint
#   deepseek     → DeepSeek via OpenAI-compatible endpoint
#
# LLM_API_BASE overrides the base URL for any provider (useful for local
# models, self-hosted endpoints, or corporate proxies).
#
# Provider quick-start examples:
#
#   # OpenAI (default)
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
#   # OpenRouter (single key for OpenAI, Anthropic, Gemini, Mistral, etc.)
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openai/gpt-4o-mini           # or anthropic/claude-3-haiku, google/gemini-flash-1.5
#   LLM_API_KEY=sk-or-...
#
#   # Anthropic (native SDK — install with: pip install -e ".[providers]")
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-3-5-haiku-20241022
#   LLM_API_KEY=sk-ant-...
#
#   # Google Gemini (OpenAI-compatible endpoint, no extra SDK needed)
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-1.5-flash
#   LLM_API_KEY=AIza...
#
#   # DeepSeek (OpenAI-compatible endpoint)
#   LLM_PROVIDER=deepseek
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-...
#
#   # Local Ollama (any provider, override base URL)
#   LLM_PROVIDER=openai
#   LLM_MODEL=llama3
#   LLM_API_KEY=ollama
#   LLM_API_BASE=http://localhost:11434/v1
#
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
# LLM_API_BASE=

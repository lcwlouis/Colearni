# CoLearni backend environment variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# PostgreSQL connection string
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://colearni:colearni@localhost:5432/colearni

# LLM — uses OpenAI SDK. Works with any OpenAI-compatible endpoint.
# Examples: gpt-4o-mini, gpt-4o, ollama/llama3 (with LLM_API_BASE set)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here
# LLM_API_BASE=http://localhost:11434/v1  # uncomment for local Ollama or compatible endpoint

# CoLearni backend environment variables
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# PostgreSQL connection string
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://colearni:colearni@localhost:5432/colearni
